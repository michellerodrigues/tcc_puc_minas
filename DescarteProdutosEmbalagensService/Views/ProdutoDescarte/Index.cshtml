@model IEnumerable<DescarteService.Data.Models.ProdutoDescarte>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IdITemEstoque)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PesoCheio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PesoVazio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VolumeEmbalagem)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DataVecimentoProduto)
                </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdITemEstoque)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PesoCheio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PesoVazio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VolumeEmbalagem)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataVecimentoProduto)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
