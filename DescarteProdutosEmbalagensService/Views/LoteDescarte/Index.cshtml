@model IEnumerable<DescarteService.Data.Models.LoteDescarte>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NomeResponsavelDescarte)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EmailResponsavelDescarte)
                </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomeResponsavelDescarte)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EmailResponsavelDescarte)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.LoteDescarteId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.LoteDescarteId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.LoteDescarteId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
