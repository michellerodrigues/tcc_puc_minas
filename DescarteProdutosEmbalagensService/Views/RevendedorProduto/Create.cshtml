@model DescarteService.Data.Models.RevendedorProduto

@{
    Layout = Layout ="~/Views/Shared/_Layout.cshtml";;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create</title>
</head>
<body>

<h4>RevendedorProduto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
